include_guard()

if(WIN32)
	set(HAVE_WIN32_CDROM 1)
elseif(APPLE)
	set(HAVE_DARWIN_CDROM 1)
elseif(LINUX)
	set(HAVE_LINUX_CDROM 1)
elseif(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
	set(HAVE_FREEBSD_CDROM 1)
elseif(CMAKE_SYSTEM_NAME STREQUAL "NetBSD" OR CMAKE_SYSTEM_NAME STREQUAL "OpenBSD")
	set(HAVE_NETBSD_CDROM 1)
elseif(CMAKE_SYSTEM_NAME STREQUAL "SunOS")
	set(HAVE_SOLARIS_CDROM 1)
elseif(CMAKE_SYSTEM_NAME STREQUAL "AIX")
	set(HAVE_AIX_CDROM 1)
endif()
